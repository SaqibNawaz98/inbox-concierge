# Copy to .env.local and edit. Then: npm run check-env
#
# Required for Gmail sign-in + thread load:
#   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GOOGLE_REDIRECT_URI, NEXT_PUBLIC_APP_URL
# Optional:
#   OPENAI_API_KEY (LLM classify; omit = rule-based only)
#   DATABASE_URL (Postgres: learning + persisted custom buckets — use docker-compose.yml)

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Gmail inbox size (GET /api/emails?limit=… is clamped to this)
# GMAIL_MAX_THREADS=5000
# GMAIL_THREADS_LIST_PAGE_SIZE=500
# GMAIL_THREAD_FETCH_CONCURRENCY=20

# Optional server-side OpenAI / OpenAI-compatible API (classification + embeddings).
# For normal use, set key, model, and API base in the app settings (gear) — nothing required here.
# Env vars below are optional: unattended hosting, CI, or defaults when the UI does not send overrides.
# LLM_API_KEY=                    # preferred generic name (same role as OPENAI_API_KEY)
OPENAI_API_KEY=
# LLM_API_BASE=https://api.openai.com/v1   # OpenAI-compatible …/v1 root (Azure, Groq, etc.)
# LLM_EMBEDDINGS_API_BASE=        # defaults to LLM_API_BASE; set if embeddings differ
# LLM_MODEL=gpt-4o-mini           # overrides OPENAI_MODEL when set
# LLM_JSON_MODE=true              # set false if /chat/completions rejects response_format
OPENAI_MODEL=gpt-4o-mini
# Fast path: one OpenAI call for the whole inbox (set false to always use batches)
OPENAI_CLASSIFY_SINGLE_SHOT=true
# Max threads allowed in that single call (Gmail UI uses 200; pad for growth)
OPENAI_CLASSIFY_SINGLE_SHOT_MAX=220
OPENAI_CLASSIFY_SINGLE_SHOT_TIMEOUT_MS=210000
OPENAI_CLASSIFY_SINGLE_SHOT_MIN_COVERAGE=0.88
OPENAI_SINGLE_SHOT_MAX_COMPLETION=8192

# Fallback: parallel mini-batches (used if single-shot fails or is disabled)
OPENAI_CLASSIFY_BATCH_SIZE=80
OPENAI_CLASSIFY_CONCURRENCY=6
OPENAI_CLASSIFY_REQUEST_TIMEOUT_MS=90000
# Speed tuning (1000+ threads): more parallel requests + larger batches (watch OpenAI rate limits)
# OPENAI_CLASSIFY_CONCURRENCY=12
# OPENAI_CLASSIFY_MAX_CONCURRENCY=16
# OPENAI_CLASSIFY_BATCH_SIZE=120
# OPENAI_CLASSIFY_MAX_BATCH_SIZE=200
# OPENAI_CLASSIFY_BATCH_MAX_COMPLETION=8192
# Parallel gap-fill waves (default 4)
# OPENAI_CLASSIFY_GAP_FILL_CONCURRENCY=6

# After main batches, extra OpenAI pass(es) for threads missing or with bad ids (default 2; set 0 to disable)
# OPENAI_CLASSIFY_GAP_FILL=false
# OPENAI_CLASSIFY_GAP_FILL_ROUNDS=2
# OPENAI_CLASSIFY_GAP_FILL_CHUNK_SIZE=40
# Stragglers after gap-fill: keyword rules (default) vs only "Can wait"
# OPENAI_CLASSIFY_RULE_GAP_FILL=true

# Postgres (learning + saved custom buckets). Port 15432 = host mapping in docker-compose.yml.
DATABASE_URL="postgresql://inbox:inbox@localhost:15432/inbox_concierge"
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# LEARNING_OVERRIDE_ON_CLASSIFY=true
# LEARNING_MIN_EXAMPLES=5
# LEARNING_TOP_K=7
# LEARNING_MIN_TOP_SIMILARITY=0.8
# LEARNING_MIN_VOTES=3
